{
  "compilerOptions": {
    // No "DOM": this is a Node/Rust-addon library, so browser globals would only mask mistakes.
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true
  },
  // test/ is checked by tsconfig.test.json instead: its `type _x = Expect<...>` aliases are
  // deliberately unreferenced and noUnusedLocals flags them.
  "exclude": ["node_modules", "native", "test"]
}
