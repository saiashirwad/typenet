{
  "name": "typenet",
  "private": true,
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:native": "pnpm -C native build",
    "format": "dprint fmt",
    "example:xor": "vite-node examples/xor.ts",
    "example:spiral": "vite-node examples/spiral.ts",
    "example:gat": "vite-node examples/gat.ts",
    "gnca": "vite-node examples/gnca/train.ts --",
    "gnca:bench": "vite-node examples/gnca/bench_gate.ts && { test -x \"$HOME/code/graph-cellular-automata/.venv/bin/python\" && \"$HOME/code/graph-cellular-automata/.venv/bin/python\" examples/gnca/bench_torch.py || echo 'torch venv not found; skipped bench_torch.py'; }"
  },
  "dependencies": {
    "hotscript": "^1.0.13",
    "tsover-runtime": "^0.0.7"
  },
  "devDependencies": {
    "@typenet/native": "workspace:*",
    "@types/node": "^26.1.1",
    "dprint": "^0.55.2",
    "prettier": "^3.5.3",
    "tsover": "npm:tsover-generic-overloads@6.0.2-generic.0",
    "typescript": "npm:tsover-generic-overloads@6.0.2-generic.0",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.10"
  },
  "prettier": {
    "arrowParens": "avoid",
    "experimentalOperatorPosition": "end",
    "experimentalTernaries": true,
    "printWidth": 60,
    "semi": false,
    "trailingComma": "none",
    "useTabs": false
  }
}
