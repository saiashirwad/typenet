{
  "name": "typenet",
  "private": true,
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "build:native": "pnpm -C native build",
    "format": "dprint fmt",
    "example:shapes": "vite-node examples/shapes.ts",
    "example:mlp": "vite-node examples/mlp.ts",
    "example:gpt": "vite-node examples/gpt.ts",
    "example:xor": "vite-node examples/xor.ts",
    "example:spiral": "vite-node examples/spiral.ts",
    "example:char-rnn": "vite-node examples/char-rnn/train.ts",
    "example:char-rnn:generate": "vite-node examples/char-rnn/generate.ts",
    "typecheck:budget": "node scripts/typecheck-budget.mjs",
    "check:readme": "node scripts/check-readme.mjs",
    "fetch:corpus": "node scripts/fetch-corpus.mjs",
    "test:ci": "pnpm test && pnpm typecheck && pnpm typecheck:budget && cargo clippy --manifest-path native/Cargo.toml --all-targets -- -D warnings"
  },
  "dependencies": {
    "hotscript": "^1.0.13",
    "tsover-runtime": "^0.0.7"
  },
  "devDependencies": {
    "@typenet/native": "workspace:*",
    "@types/node": "^26.1.1",
    "dprint": "^0.55.2",
    "tsover": "npm:tsover-generic-overloads@6.0.2-generic.0",
    "typescript": "npm:tsover-generic-overloads@6.0.2-generic.0",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
